{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://ailearninghub.law.stanford.edu https://sites.google.com https://*.google.com https://*.googleusercontent.com"
        }
      ]
    }
  ]
}
